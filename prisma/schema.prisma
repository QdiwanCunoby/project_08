// Naming: camelCase nel codice, snake_case nel DB (@map per i campi, @@map per le tabelle)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE

  @@map("customer_status")
}

enum AccountType {
  CHECKING
  SAVINGS
  BUSINESS

  @@map("account_type")
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  CLOSED

  @@map("account_status")
}

enum TransferStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("transfer_status")
}

model Customer {
  id         String         @id @default(uuid()) @db.Uuid
  fiscalCode String         @unique @map("fiscal_code") @db.VarChar(16)
  firstName  String         @map("first_name") @db.VarChar(100)
  lastName   String         @map("last_name") @db.VarChar(100)
  email      String         @unique
  phone      String         @db.VarChar(25)
  status     CustomerStatus @default(ACTIVE)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  // Soft delete: valorizzato = cliente "cancellato". L'estensione Prisma (src/config/prisma.ts) lo nasconde alle letture
  deletedAt  DateTime?      @map("deleted_at")

  accounts     Account[]
  user         User?
  kycDocuments KycDocument[]

  @@index([deletedAt])
  @@map("customers")
}

// Documenti KYC (Know Your Customer: carta d'identità, codice fiscale, prova di residenza)
model KycDocument {
  id         String   @id @default(uuid()) @db.Uuid
  // @db.Uuid come Customer.id: una FK text → uuid in Postgres non si può creare
  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id])
  // Nome originale del file, ripulito: SOLO da mostrare, mai usato per costruire percorsi
  fileName   String   @map("file_name")
  // MIME verificato sul contenuto (magic number), non solo quello dichiarato dal client
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  // Dove sta il file: path locale in questo bootcamp, URL Azure Blob / S3 in produzione
  storageUrl String   @map("storage_url")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@index([customerId])
  @@map("kyc_documents")
}

model Account {
  id        String        @id @default(uuid()) @db.Uuid
  iban      String        @unique @db.VarChar(27)
  // Decimal(15,2): importi bancari esatti (un Float perderebbe centesimi)
  balance   Decimal       @default(0) @db.Decimal(15, 2)
  type      AccountType
  status    AccountStatus @default(ACTIVE)
  ownerId   String        @map("owner_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  // Soft delete: DELETE /api/accounts/:id valorizza questo campo invece di cancellare la riga
  // (i bonifici che la referenziano restano consultabili: lo storico bancario non si perde)
  deletedAt DateTime?     @map("deleted_at")

  // Restrict: un cliente con conti non si cancella (i dati bancari non spariscono a cascata)
  owner        Customer   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  transfersOut Transfer[] @relation("TransferFrom")
  transfersIn  Transfer[] @relation("TransferTo")

  // Copre "i conti di un cliente filtrati per stato"
  @@index([ownerId, status])
  @@index([deletedAt])
  @@map("accounts")
}

model Transfer {
  id            String         @id @default(uuid()) @db.Uuid
  fromAccountId String         @map("from_account_id") @db.Uuid
  toAccountId   String         @map("to_account_id") @db.Uuid
  amount        Decimal        @db.Decimal(15, 2)
  description   String?        @db.VarChar(140)
  status        TransferStatus @default(PENDING)
  executedAt    DateTime?      @map("executed_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  fromAccount Account @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   Account @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)

  // Le FK in Postgres non creano indici da sole: servono per lo storico di un conto
  @@index([fromAccountId])
  @@index([toAccountId])
  // Feed movimenti con cursor pagination: ORDER BY executed_at DESC, id DESC (l'id rende l'ordine totale)
  @@index([executedAt(sort: Desc), id(sort: Desc)])
  @@map("transfers")
}

enum Role {
  USER
  OPERATOR
  ADMIN

  @@map("role")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(USER)
  // 1:1 opzionale con il cliente bancario (un operatore/admin può non avere un Customer)
  customerId   String?   @unique @map("customer_id") @db.Uuid
  customer     Customer? @relation(fields: [customerId], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at")

  refreshTokens RefreshToken[]

  @@map("users")
}

// Refresh token lato server (rotation): `id` è il claim jti del JWT. Un token è utilizzabile UNA sola volta:
// al refresh viene revocato e sostituito. Se un token già revocato viene ripresentato → furto: si revocano tutti.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}
